{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svmps-semla-portal",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Automatically compiles the Vite React frontend into ./dist before deploy
  "build": {
    "command": "npm run build"
  },
  // Cloudflare Workers Static Assets pointing directly to Vite build output folder
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Cloudflare D1 Serverless Database binding
  // Create your database via: npx wrangler d1 create saraswati_school_d1
  // and paste the generated database_id UUID below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saraswati_school_d1",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
