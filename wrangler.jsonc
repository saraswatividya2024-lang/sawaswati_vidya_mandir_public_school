{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sawaswati-vidya-mandir-public-school",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Automatically compiles the Vite React frontend into ./dist before deploy
  "build": {
    "command": "npm run build"
  },
  // Cloudflare Workers Static Assets pointing directly to Vite build output folder
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
  // Cloudflare D1 Database Binding:
  // Option 1 (Cloudflare Dashboard - Recommended):
  //   In Cloudflare Workers Dashboard -> sawaswati-vidya-mandir-public-school -> Settings -> Variables and Bindings
  //   Add D1 Database binding with Variable Name: "DB", selecting your D1 database.
  // Option 2 (Via config file):
  //   Create your D1 database with: npx wrangler d1 create saraswati_school_d1
  //   Then uncomment the block below and replace the placeholder with your real D1 UUID:
  /*
  ,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saraswati_school_d1",
      "database_id": "<YOUR_D1_DATABASE_UUID>"
    }
  ]
  */
}
